{
  "name": "Neclatrony - Sistema Multiagente e Hiperautomatización Dental",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-neclatrony",
        "options": {}
      },
      "id": "1",
      "name": "Webhook Telegram Ingest",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalizar mensaje de Telegram\nconst body = $input.first().json.body || $input.first().json;\nlet chat_id = null;\nlet text = '';\nlet user_name = '';\n\nif (body.message) {\n  chat_id = body.message.chat.id;\n  text = body.message.text || '';\n  user_name = body.message.from.first_name || 'Paciente';\n} else if (body.callback_query) {\n  chat_id = body.callback_query.message.chat.id;\n  text = body.callback_query.data || '';\n  user_name = body.callback_query.from.first_name || 'Paciente';\n}\n\nreturn [{\n  json: {\n    chat_id,\n    text,\n    user_name,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "2",
      "name": "Normalizador de Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.0,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Eres el Agente 1 de Triaje de Clínica Dental Neclatrony. Clasifica el mensaje en: CITA_NUEVA, CITA_REPROGRAMAR, CITA_CANCELAR, CONSULTA_FAQ, URGENCIA_MEDICA, QUEJA_RECLAMO. Devuelve JSON con: intent, confidence, urgency_level, detected_specialty.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.text) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "3",
      "name": "Agente 1: Clasificador GPT-4o",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parsear el JSON retornado por OpenAI\nconst rawContent = $input.first().json.choices[0].message.content;\nconst parsed = JSON.parse(rawContent);\nconst prev = $('Normalizador de Datos').first().json;\n\nreturn [{\n  json: {\n    chat_id: prev.chat_id,\n    text: prev.text,\n    user_name: prev.user_name,\n    intent: parsed.intent || 'CONSULTA_FAQ',\n    confidence: parsed.confidence || 0.9,\n    urgency_level: parsed.urgency_level || 'BAJA',\n    detected_specialty: parsed.detected_specialty || null\n  }\n}];"
      },
      "id": "4",
      "name": "Parsear Intención",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "URGENCIA_MEDICA",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "QUEJA_RECLAMO",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "CONSULTA_FAQ",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "CITA",
                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "5",
      "name": "Router de Intenciones",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "🚨 *ALERTA MÉDICA PRIORITARIA*\nHemos registrado tus síntomas como urgentes.\n\n⚠️ *Primeros Auxilios:* Si hay hemorragia, presiona con gasa estéril continua. Aplica frío externo en la mejilla. NO te automediques.\n\nUn profesional de recepción te llamará de inmediato. Teléfono directo: *+34 933 394 358*.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "6",
      "name": "Telegram: Urgencia",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1380,
        100
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "Estimado/a {{ $json.user_name }}, hemos registrado tu mensaje de reclamación formalmente. La dirección médica revisará tu caso y se pondrá en contacto contigo en un plazo máximo de 24 horas laborables.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "7",
      "name": "Telegram: Queja",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1380,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.1,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Eres el Agente RAG de Preguntas Frecuentes de la Clínica Dental Neclatrony. Responde cordialmente sobre precios (limpieza 45€, empaste 50-70€, implante desde 590€, ortodoncia invisible desde 2400€), financiación a 36 meses sin intereses y seguros (Sanitas, Adeslas, Mapfre, DKV, Asisa). Si piden diagnósticos, sugiere agendar cita presencial.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.text) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "8",
      "name": "Agente 3: RAG FAQ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
