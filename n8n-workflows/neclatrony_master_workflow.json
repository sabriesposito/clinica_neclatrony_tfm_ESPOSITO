        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"temperature\": 0.2,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Eres el Agente Gestor de Citas de Clínica Dental Neclatrony. Pide amablemente los datos necesarios: DNI, si es nuevo (nombre y teléfono), especialidad (General, Implante, Ortodoncia, Cirugía), fecha y hora deseada (de 09:00 a 18:30). Si pide hora ocupada o fuera de rango (como las 15:00), ofrece las alternativas 11:30 o 16:00.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.text) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "10",
      "name": "Agente 2: Gestor Citas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        520
      ]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Parsear Intención').first().json.chat_id }}",
        "text": "={{ $json.choices[0].message.content }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "11",
